<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="Interior design services in Hyderabad by SV Home Interiors — Modular kitchens, false ceilings, wardrobes, living & bedroom designs, 2BHK & 3BHK turnkey packages.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site-body">
    <%- include('../partials/header') %>

    <!-- Page Banner -->
    <section class="page-banner">
        <div class="container page-banner-inner">
            <span class="page-tag"><i class="fas fa-couch text-gold"></i> COMPLETE INTERIOR SERVICES • HYDERABAD</span>
            <h1 class="page-title">Comprehensive <span class="gold-gradient-text">Home Interior Services</span></h1>
            <p class="page-subtitle">Expert architectural craftsmanship for apartments, luxury villas, and commercial properties across Hyderabad.</p>
        </div>
    </section>

    <!-- Services Detailed List -->
    <section class="section">
        <div class="container">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
                <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
                    <% services.forEach(service => { %>
                    <div class="feature-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 30px;">
                        <div>
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                                <div class="feature-icon" style="margin-bottom: 0;">
                                    <i class="fas <%= service.icon || 'fa-couch' %> text-gold" style="font-size: 2.2rem;"></i>
                                </div>
                                <% if (service.starting_price) { %>
                                <span style="background: rgba(212,175,55,0.12); color: var(--gold-light); border: 1px solid rgba(212,175,55,0.3); padding: 4px 12px; border-radius: 6px; font-weight: 700; font-size: 0.85rem;">
                                    Starts <%= service.starting_price %>
                                </span>
                                <% } %>
                            </div>
                            <h2 style="font-size: 1.35rem; margin-bottom: 12px; color: var(--text-light);"><%= service.title %></h2>
                            <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 18px;"><%= service.short_description %></p>
                            
                            <% if (service.full_description) { %>
                            <p style="color: var(--text-dim); font-size: 0.88rem; line-height: 1.6; margin-bottom: 20px;"><%= service.full_description %></p>
                            <% } %>
                        </div>

                        <div style="padding-top: 18px; border-top: 1px solid var(--border-dark); display: flex; gap: 10px;">
                            <button type="button" class="btn btn-gold" style="flex: 1;" onclick="openEnquiryModal('Home Interiors', '<%= (service.title || '').replace(/'/g, '\\\'') %>')">
                                <i class="fas fa-calendar-alt"></i> Book Consultation
                            </button>
                            <a href="https://wa.me/<%= businessWhatsapp %>?text=Hello%20SV%20Home%20Interiors,%20I%20am%20interested%20in%20<%= encodeURIComponent(service.title) %>" target="_blank" class="btn btn-whatsapp" style="padding: 10px 16px;">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                        </div>
                    </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Materials & Standards Section -->
    <section class="section" style="background: var(--bg-dark);">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">MATERIALS & HARDWARE</span>
                <h2 class="section-title">Built With <span class="gold-gradient-text">World-Class Materials</span></h2>
                <p class="section-subtitle">We partner exclusively with top-tier international hardware and board manufacturers.</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-layer-group text-gold"></i></div>
                    <h3>BWP Marine Grade Plywood</h3>
                    <p>Boiling Waterproof (BWP) 710-grade calibrated hardwood ply, 100% borer and termite resistant for lifelong kitchen and wardrobe carcass.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-cog text-gold"></i></div>
                    <h3>German Soft-Close Hardware</h3>
                    <p>Lifetime-tested soft-close hinges, tandem drawers, and lift-up flaps from Hafele, Hettich, and Blum with zero noise operation.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-gem text-gold"></i></div>
                    <h3>Anti-Fingerprint Finishes</h3>
                    <p>Super-matte zero-glare acrylics, anti-scratch PU coatings, and antibacterial high-pressure laminates easy to clean.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-lightbulb text-gold"></i></div>
                    <h3>Smart Ambient Lighting</h3>
                    <p>Concealed LED strip profiles, motion sensors, magnetic spotlights, and warm color temperature (3000K-4000K) illumination.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Consultation CTA -->
    <section class="cta-banner-section">
        <div class="container">
            <div class="cta-banner-card">
                <div class="cta-text">
                    <h2>Need a Customized Interior Package for Your Home?</h2>
                    <p>Share your floor plan with our design team for an immediate itemized quotation and 3D preview.</p>
                </div>
                <div class="cta-buttons">
                    <button type="button" class="btn btn-gold btn-large" onclick="openEnquiryModal('Home Interiors')">
                        <i class="fas fa-envelope"></i> Request Custom Quote
                    </button>
                    <a href="/interiors/contact" class="btn btn-outline-gold btn-large">
                        <i class="fas fa-phone-alt"></i> Contact Interior Studio
                    </a>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/enquiry-modal') %>
    <%- include('../partials/chatbot') %>

    <script src="/js/main.js"></script>
    <script src="/js/chatbot.js"></script>
</body>
</html>

