<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="Discover premier luxury villas, gated community plots, high-rise apartments, and turnkey home interiors in Hyderabad with SV Real Estates. Verified titles, transparent deals, and prime locations.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site-body">
    <%- include('../partials/header') %>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-bg-overlay"></div>
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
        
        <div class="container hero-content">
            <div class="hero-badge animate-fade-down">
                <i class="fas fa-crown text-gold"></i>
                <span>HYDERABAD'S PREMIER REAL ESTATE & INTERIOR ADVISORY</span>
            </div>
            
            <h1 class="hero-title animate-fade-up">
                <% if (typeof heroTitle !== 'undefined' && heroTitle) { %>
                    <%- heroTitle %>
                <% } else { %>
                    Redefining <span class="gold-gradient-text">Luxury Living</span>, Strategic Land & Bespoke Interiors
                <% } %>
            </h1>
            
            <p class="hero-subtitle animate-fade-up">
                <%= (typeof heroSubtitle !== 'undefined' && heroSubtitle) ? heroSubtitle : 'Explore handpicked luxury villas, HMDA approved plots, 2BHK/3BHK/4BHK gated apartments, and complete home interior solutions across Hyderabad.' %>
            </p>

            <!-- Hero Search Filter Bar -->
            <div class="hero-search-card animate-fade-up">
                <form action="/properties" method="GET" class="hero-search-form">
                    <div class="search-field">
                        <label><i class="fas fa-th-large text-gold"></i> Category</label>
                        <select name="category">
                            <option value="">All Categories</option>
                            <option value="apartment">Apartments / Flats</option>
                            <option value="villa">Luxury Villas</option>
                            <option value="residential_plot">Residential Plots</option>
                            <option value="commercial">Commercial Space</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label><i class="fas fa-bed text-gold"></i> Bedrooms</label>
                        <select name="bedrooms">
                            <option value="">Any BHK</option>
                            <option value="2">2 BHK (from ₹70L)</option>
                            <option value="3">3 BHK</option>
                            <option value="4">4 BHK</option>
                            <option value="5">5+ BHK</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label><i class="fas fa-map-marker-alt text-gold"></i> Locality</label>
                        <input type="text" name="locality" placeholder="Kokapet, Tellapur, Financial District...">
                    </div>

                    <div class="search-field">
                        <label><i class="fas fa-rupee-sign text-gold"></i> Budget</label>
                        <select name="min_price">
                            <option value="">₹70L to ₹6 Cr (All)</option>
                            <option value="7000000">₹70 Lakhs+</option>
                            <option value="10000000">₹1 Crore+</option>
                            <option value="20000000">₹2 Crore+</option>
                            <option value="30000000">₹3 Crore+</option>
                            <option value="40000000">₹4 Crore+</option>
                            <option value="50000000">₹5 Crore+ (up to ₹6 Cr)</option>
                        </select>
                    </div>

                    <div class="search-field btn-field">
                        <button type="submit" class="btn btn-gold btn-hero-search">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </form>

                <!-- Popular Search Badges -->
                <div class="hero-quick-tags">
                    <span>Popular Searches:</span>
                    <a href="/properties?bedrooms=2&category=apartment">2 BHK Flats</a>
                    <a href="/properties?bedrooms=3&locality=Tellapur">3 BHK in Tellapur</a>
                    <a href="/properties?category=villa">Luxury Villas</a>
                    <a href="/properties?category=residential_plot">HMDA Plots</a>
                    <a href="/properties?locality=Kokapet">Kokapet Neopolis</a>
                    <a href="/interiors"><i class="fas fa-couch text-gold"></i> Home Interiors</a>
                </div>
            </div>

            <!-- Quick Stats Counters -->
            <div class="hero-stats-row">
                <div class="hero-stat-item">
                    <span class="stat-big">15+</span>
                    <span class="stat-desc">Years in Hyderabad Real Estate</span>
                </div>
                <div class="stat-divider"></div>
                <div class="hero-stat-item">
                    <span class="stat-big">500+</span>
                    <span class="stat-desc">Acres Developed & Advised</span>
                </div>
                <div class="stat-divider"></div>
                <div class="hero-stat-item">
                    <span class="stat-big">100%</span>
                    <span class="stat-desc">RERA & HMDA Clear Titles</span>
                </div>
                <div class="stat-divider"></div>
                <div class="hero-stat-item">
                    <span class="stat-big">3,200+</span>
                    <span class="stat-desc">Satisfied Homeowners & Clients</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Section -->
    <section class="section categories-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">PORTFOLIO</span>
                <h2 class="section-title">Explore by <span class="gold-gradient-text">Property Type</span></h2>
                <p class="section-subtitle">Curated investments across prime residential, commercial, and agricultural hubs in Telangana.</p>
            </div>

            <div class="categories-grid">
                <a href="/properties?category=villa" class="category-card">
                    <div class="cat-icon"><i class="fas fa-house-chimney-window"></i></div>
                    <h3>Luxury Villas</h3>
                    <p>Triplex & gated designer villas with private pools, clubhouses, and elite living.</p>
                    <span class="cat-link">View Listings <i class="fas fa-arrow-right"></i></span>
                </a>

                <a href="/properties?category=residential_plot" class="category-card featured-cat">
                    <div class="cat-badge">High Growth</div>
                    <div class="cat-icon"><i class="fas fa-vector-square"></i></div>
                    <h3>Residential Plots</h3>
                    <p>HMDA & DTCP clear title open plots with underground cabling and 100ft road access.</p>
                    <span class="cat-link">View Listings <i class="fas fa-arrow-right"></i></span>
                </a>

                <a href="/properties?category=apartment" class="category-card">
                    <div class="cat-icon"><i class="fas fa-building"></i></div>
                    <h3>Gated Apartments</h3>
                    <p>2BHK, 3BHK & 4BHK high-rise sky residences near IT corridors & metro stations.</p>
                    <span class="cat-link">View Listings <i class="fas fa-arrow-right"></i></span>
                </a>

                <a href="/interiors" class="category-card" style="border: 1px solid var(--gold); background: linear-gradient(135deg, rgba(212,175,55,0.08), rgba(18,20,26,0.95));">
                    <div class="cat-badge" style="background: var(--gold); color: #0b0c10;">Turnkey</div>
                    <div class="cat-icon"><i class="fas fa-couch text-gold"></i></div>
                    <h3>Home Interiors</h3>
                    <p>Modular kitchens, false ceiling, wardrobes, and complete luxury villa interior execution.</p>
                    <span class="cat-link" style="color: var(--gold-light);">Explore Interiors <i class="fas fa-arrow-right"></i></span>
                </a>
            </div>
        </div>
    </section>

    <!-- Featured Properties Section (Optimized 4:3 Aspect Ratio Cards) -->
    <section class="section featured-properties-section" id="featuredProperties">
        <div class="container">
            <div class="section-header-flex">
                <div>
                    <span class="section-badge">HANDPICKED SELECTION</span>
                    <h2 class="section-title">Featured <span class="gold-gradient-text">Properties</span></h2>
                    <p class="section-subtitle">Premium verified properties across prime Hyderabad growth corridors.</p>
                </div>
                <a href="/properties" class="btn btn-outline-gold">View All Properties <i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="properties-grid">
                <% if (!featuredProperties || featuredProperties.length === 0) { %>
                <div class="empty-listings-box">
                    <i class="fas fa-home fa-3x text-gold"></i>
                    <h3>No Featured Properties Yet</h3>
                    <p>Our catalog is being updated with fresh prime inventory. Browse all active listings or get in touch directly.</p>
                    <a href="/properties" class="btn btn-gold">Browse Catalog</a>
                </div>
                <% } else { %>
                <% featuredProperties.forEach(prop => { %>
                <div class="property-card" data-category="<%= prop.category %>">
                    <div class="prop-card-media" style="aspect-ratio: 4/3; width: 100%; height: auto; min-height: 250px;">
                        <% if (prop.cover_image) { %>
                        <img src="<%= prop.cover_image %>" alt="<%= prop.title %> — <%= (prop.category || '').replace(/_/g, ' ') %> in <%= prop.locality || 'Hyderabad' %>" class="prop-img" loading="lazy" onerror="this.onerror=null; this.src='/images/brand-banner.png';">
                        <% } else { %>
                        <div class="prop-img-placeholder">
                            <i class="fas fa-building"></i>
                            <span>SV Real Estates</span>
                        </div>
                        <% } %>
                        <div class="prop-badge-top">
                            <span class="badge-featured"><i class="fas fa-star"></i> Featured</span>
                            <span class="badge-category"><%= (prop.category || '').replace(/_/g, ' ') %></span>
                        </div>
                        <div class="prop-price-tag">
                            <% if (prop.price) { %>
                            ₹<%= Number(prop.price) >= 10000000 ? (prop.price / 10000000).toFixed(2) + ' Cr' : (prop.price / 100000).toFixed(2) + ' L' %>
                            <% } else { %>
                            Price on Request
                            <% } %>
                        </div>
                    </div>

                    <div class="prop-card-body">
                        <div class="prop-location">
                            <i class="fas fa-map-marker-alt text-gold"></i>
                            <span><%= prop.locality ? prop.locality + ', ' : '' %><%= prop.city %></span>
                        </div>
                        <h3 class="prop-title">
                            <a href="/properties/<%= prop.id %>"><%= prop.title %></a>
                        </h3>
                        <% if (prop.short_description) { %>
                        <p class="prop-desc"><%= prop.short_description %></p>
                        <% } %>

                        <div class="prop-specs-row">
                            <% if (prop.bedrooms) { %>
                            <div class="spec-item"><i class="fas fa-bed"></i> <%= prop.bedrooms %> BHK</div>
                            <% } %>
                            <% if (prop.bathrooms) { %>
                            <div class="spec-item"><i class="fas fa-bath"></i> <%= prop.bathrooms %> Bath</div>
                            <% } %>
                            <% if (prop.built_up_area || prop.plot_area) { %>
                            <div class="spec-item">
                                <i class="fas fa-ruler-combined"></i>
                                <%= (prop.built_up_area || prop.plot_area).toLocaleString() %> <%= (prop.area_unit || 'sq_ft').replace(/_/g, ' ') %>
                            </div>
                            <% } %>
                            <% if (prop.facing) { %>
                            <div class="spec-item"><i class="fas fa-compass"></i> <%= prop.facing %></div>
                            <% } %>
                        </div>

                        <div class="prop-card-footer">
                            <button type="button" class="btn btn-card-enquire"
                                data-prop-id="<%= prop.id %>"
                                data-prop-title="<%= (prop.title || '').replace(/"/g, '&quot;') %>"
                                data-prop-code="<%= prop.property_code || '' %>"
                                data-prop-category="<%= prop.category || '' %>">
                                <i class="fas fa-envelope"></i> Enquire Now
                            </button>
                            <a href="/properties/<%= prop.id %>" class="btn btn-card-details">
                                Details <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <% }) %>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Home Interiors Showcase Section -->
    <section class="section" style="background: var(--bg-dark);" id="homeInteriorsShowcase">
        <div class="container">
            <div class="section-header-flex">
                <div>
                    <span class="section-badge"><i class="fas fa-couch text-gold"></i> SV HOME INTERIORS</span>
                    <h2 class="section-title">Bespoke <span class="gold-gradient-text">Home Interiors</span></h2>
                    <p class="section-subtitle">German joinery hardware, 45-day guaranteed handover & 10-year warranty for your flat or villa.</p>
                </div>
                <a href="/interiors" class="btn btn-gold">Explore All Interiors <i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="properties-grid">
                <% if (typeof interiorProjects !== 'undefined' && interiorProjects && interiorProjects.length > 0) { %>
                    <% interiorProjects.slice(0, 3).forEach(proj => { %>
                    <div class="property-card">
                        <div class="prop-card-media" style="aspect-ratio: 4/3; width: 100%; height: auto; min-height: 250px;">
                            <img src="<%= proj.cover_image || 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=800&q=80' %>" alt="<%= proj.title %>" class="prop-img" loading="lazy" onerror="this.onerror=null; this.src='/images/brand-banner.png';">
                            <div class="prop-badge-top">
                                <span class="badge-featured"><i class="fas fa-check-circle"></i> Completed</span>
                                <span class="badge-category"><%= proj.bhk_config || proj.property_type %></span>
                            </div>
                            <% if (proj.budget_range) { %>
                            <div class="prop-price-tag"><%= proj.budget_range %></div>
                            <% } %>
                        </div>
                        <div class="prop-card-body">
                            <div class="prop-location">
                                <i class="fas fa-map-marker-alt text-gold"></i>
                                <span><%= proj.locality %>, <%= proj.city || 'Hyderabad' %></span>
                            </div>
                            <h3 class="prop-title">
                                <a href="/interiors/projects/<%= proj.slug || proj.id %>"><%= proj.title %></a>
                            </h3>
                            <p class="prop-desc"><%= proj.short_description %></p>
                            <div class="prop-card-footer" style="margin-top: 14px;">
                                <button type="button" class="btn btn-card-enquire" onclick="openEnquiryModal('Home Interiors', '<%= (proj.title || '').replace(/'/g, '\\\'') %>')">
                                    <i class="fas fa-calendar-check"></i> Free 3D Plan
                                </button>
                                <a href="/interiors/projects/<%= proj.slug || proj.id %>" class="btn btn-card-details">
                                    View Project <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div class="property-card">
                        <div class="prop-card-media" style="aspect-ratio: 4/3; width: 100%; height: auto;">
                            <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=800&q=80" alt="Kokapet Villa Interior" class="prop-img" loading="lazy">
                        </div>
                        <div class="prop-card-body">
                            <div class="prop-location"><i class="fas fa-map-marker-alt text-gold"></i> Kokapet, Hyderabad</div>
                            <h3 class="prop-title"><a href="/interiors">4BHK Luxury Villa Interior</a></h3>
                            <p class="prop-desc">Contemporary Italian marble finishes and custom modular joinery.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Why Choose SV Real Estates Section -->
    <section class="section why-us-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">UNCOMPROMISING EXCELLENCE</span>
                <h2 class="section-title">The <span class="gold-gradient-text">SV Real Estates</span> Standard</h2>
                <p class="section-subtitle">We bridge discerning buyers with validated, legal, and high-appreciation properties.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-stamp text-gold"></i></div>
                    <h3>100% Legal Title Due Diligence</h3>
                    <p>Every single listing undergoes 30-year title verification, link document checking, and RERA/HMDA compliance audit by certified legal counsel.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-handshake text-gold"></i></div>
                    <h3>Direct Developer & Owner Pricing</h3>
                    <p>Zero hidden margins, transparent documentation, and authentic price parity guarantee for plots, villas, and apartments.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-car-side text-gold"></i></div>
                    <h3>Complimentary Chauffeur Site Visits</h3>
                    <p>Experience hassle-free property inspections with our dedicated relationship managers who arrange chauffeured site visits 7 days a week.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-chart-line text-gold"></i></div>
                    <h3>High Capital Appreciation Zones</h3>
                    <p>We specialize in Hyderabad's growth corridors: Neopolis Kokapet, Tellapur, Shankarpally, Mokila, Kompally, and Bachupally.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Hyderabad Prime Locations Banner -->
    <section class="section locations-preview-section">
        <div class="container">
            <div class="section-header-flex">
                <div>
                    <span class="section-badge">SERVING ALL OVER HYDERABAD</span>
                    <h2 class="section-title">Prime Locations <span class="gold-gradient-text">All Over Hyderabad</span></h2>
                    <p class="section-subtitle">Verified properties and strategic land investments across West, North, South, East, and Central corridors.</p>
                </div>
                <a href="/locations" class="btn btn-outline-gold">Explore All Localities <i class="fas fa-map-marked-alt"></i></a>
            </div>

            <div class="location-cards-grid">
                <a href="/properties?locality=Jubilee+Hills" class="loc-card">
                    <div class="loc-content">
                        <h3>Jubilee Hills & Banjara</h3>
                        <span>Ultra-Luxury Villas • High-Net-Worth Residential</span>
                    </div>
                </a>
                <a href="/properties?locality=Kokapet" class="loc-card">
                    <div class="loc-content">
                        <h3>Kokapet & Neopolis</h3>
                        <span>Golden Mile • Sky Villas & Premium Open Plots</span>
                    </div>
                </a>
                <a href="/properties?locality=Gachibowli" class="loc-card">
                    <div class="loc-content">
                        <h3>Gachibowli & Financial Dist</h3>
                        <span>IT Hub • Gated High-Rise Communities</span>
                    </div>
                </a>
                <a href="/properties?locality=Tellapur" class="loc-card">
                    <div class="loc-content">
                        <h3>Tellapur & Kollur</h3>
                        <span>Booming Green Suburbs • Modern Villa Projects</span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Leadership & Governance Section -->
    <% if (typeof leadershipProfiles !== 'undefined' && leadershipProfiles && leadershipProfiles.some(l => l.show_on_home)) { %>
    <section class="section leadership-preview-section" style="background: rgba(255,255,255,0.015); border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark);">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">LEADERSHIP & GOVERNANCE</span>
                <h2 class="section-title">Guided by <span class="gold-gradient-text">Experienced Leadership</span></h2>
                <p class="section-subtitle">Over two decades of verified land acquisition, legal due diligence, and architectural excellence in Hyderabad.</p>
            </div>

            <div class="team-grid" style="max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
                <% leadershipProfiles.filter(l => l.show_on_home).forEach(member => { %>
                <div class="team-card" style="background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: var(--radius-md); padding: 28px; text-align: center;">
                    <% if (member.photo_url) { %>
                    <div class="team-avatar" style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; margin: 0 auto 16px; border: 2px solid var(--gold);">
                        <img src="<%= member.photo_url %>" alt="<%= member.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <% } else { %>
                    <div class="team-avatar" style="width: 70px; height: 70px; border-radius: 50%; background: rgba(212,175,55,0.12); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 16px;">
                        <i class="fas <%= member.role_type === 'founder' || member.role_type === 'owner' ? 'fa-crown' : 'fa-user-tie' %>"></i>
                    </div>
                    <% } %>
                    <h3 style="font-size: 1.2rem; color: #fff; margin-bottom: 4px;"><%= member.name %></h3>
                    <span class="team-designation" style="color: var(--gold); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 12px;"><%= member.designation %></span>
                    <p class="team-bio" style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5;"><%= member.bio %></p>
                </div>
                <% }) %>
            </div>
            
            <div style="text-align: center; margin-top: 28px;">
                <a href="/about#leadership" class="btn btn-outline-gold" style="font-size: 0.85rem; padding: 8px 18px;">
                    Read Complete Executive Heritage <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
    <% } %>

    <!-- CTA Section -->
    <section class="cta-banner-section">
        <div class="container">
            <div class="cta-banner-card">
                <div class="cta-text">
                    <h2>Looking to Buy, Sell, or Design in Hyderabad?</h2>
                    <p>Speak directly with our principal advisors for tailored options, private walkthroughs, and turnkey interior design packages.</p>
                </div>
                <div class="cta-buttons">
                    <button type="button" class="btn btn-gold btn-large" onclick="openEnquiryModal()">
                        <i class="fas fa-envelope"></i> Enquire Now
                    </button>
                    <a href="https://wa.me/<%= businessWhatsapp %>" target="_blank" class="btn btn-whatsapp btn-large">
                        <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/enquiry-modal') %>
    <%- include('../partials/chatbot') %>

    <!-- Scripts -->
    <script src="/js/main.js"></script>
    <script src="/js/chatbot.js"></script>
</body>
</html>
