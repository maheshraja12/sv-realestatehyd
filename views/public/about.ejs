<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="About SV Real Estates & Home Interiors Hyderabad — Over 15 years of excellence in verified luxury real estate, open plots, and bespoke interior design across Telangana.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site-body">
    <%- include('../partials/header') %>

    <!-- Page Banner -->
    <section class="page-banner">
        <div class="container page-banner-inner">
            <span class="page-tag"><i class="fas fa-crown text-gold"></i> ESTABLISHED LEGACY • ALL OVER HYDERABAD</span>
            <h1 class="page-title">About <span class="gold-gradient-text"><%= businessName %></span></h1>
            <p class="page-subtitle">Hyderabad's benchmark in building construction materials, supply chain reliability, verified real estate, and bespoke home interiors all over Hyderabad.</p>
        </div>
    </section>

    <!-- Brand Story Section -->
    <section class="section about-story-section">
        <div class="container">
            <div class="about-story-grid">
                <div class="about-text-col">
                    <span class="section-badge">OUR FOUNDATION</span>
                    <h2 class="section-title">A Legacy Built on <span class="gold-gradient-text">Uncompromising Trust</span></h2>
                    <p class="story-lead">
                        Founded with a steadfast mission to serve construction and property needs in Telangana, <strong><%= businessName %></strong> stands as a symbol of quality materials, legal precision, and customer-first service.
                    </p>
                    <p>
                        Over the past decade and a half, Hyderabad has transformed into one of India’s most dynamic global business capitals. As the IT corridor, Outer Ring Road (ORR), and Regional Ring Road (RRR) opened up unprecedented wealth creation avenues, our team has helped thousands of families and NRI investors identify secure, high-yield plots, luxury villas, and prime commercial parcels all over Hyderabad.
                    </p>
                    <p>
                        We operate on an unwavering philosophy: <em>Every square yard we recommend must pass the exact rigorous title scrutiny we would demand for our own families.</em>
                    </p>

                    <div class="story-highlights-row">
                        <div class="story-hl">
                            <span class="hl-num">15+</span>
                            <span class="hl-lbl">Years of Excellence</span>
                        </div>
                        <div class="story-hl">
                            <span class="hl-num">500+</span>
                            <span class="hl-lbl">Acres Developed</span>
                        </div>
                        <div class="story-hl">
                            <span class="hl-num">3,200+</span>
                            <span class="hl-lbl">Satisfied Clients</span>
                        </div>
                    </div>
                </div>

                <div class="about-visual-col">
                    <div class="visual-box-card">
                        <div class="gold-frame-decor"></div>
                        <div class="visual-content">
                            <div class="brand-monogram-large">SV</div>
                            <h3>The Gold Standard in Telangana Real Estate</h3>
                            <ul class="check-list">
                                <li><i class="fas fa-check-circle text-gold"></i> 30-Year Comprehensive Title Search</li>
                                <li><i class="fas fa-check-circle text-gold"></i> 100% HMDA / RERA / DTCP Approved Layouts</li>
                                <li><i class="fas fa-check-circle text-gold"></i> Zero Litigation & Clean Link Deeds Guarantee</li>
                                <li><i class="fas fa-check-circle text-gold"></i> Turnkey Home Interiors & Execution</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values Section -->
    <section class="section core-values-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">OUR CODE</span>
                <h2 class="section-title">Core Principles That <span class="gold-gradient-text">Guide Us</span></h2>
                <p class="section-subtitle">Values that distinguish our practice in an evolving real estate market.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-balance-scale text-gold"></i></div>
                    <h3>Radical Transparency</h3>
                    <p>No artificial price markups, concealed encumbrances, or misleading timelines. We lay out full legal records and market comps upfront.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-shield-halved text-gold"></i></div>
                    <h3>Legal Due Diligence</h3>
                    <p>Our in-house panel of high court revenue advocates and property legal experts thoroughly examine every survey number before listing.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-chart-pie text-gold"></i></div>
                    <h3>Wealth Appreciation</h3>
                    <p>We analyze infrastructure blueprints, metro extensions, and SEZ zones to locate properties positioned for exponential 5-10 year appreciation.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-hand-holding-heart text-gold"></i></div>
                    <h3>Turnkey Solutions</h3>
                    <p>From initial land purchase and clear-title registration to complete modern interior design and handover, we manage every phase under one roof.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Leadership Section (Dynamically Loaded from Database / CMS) -->
    <section class="section team-section" id="leadership">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">LEADERSHIP</span>
                <h2 class="section-title">Meet Our <span class="gold-gradient-text">Executive Team</span></h2>
                <p class="section-subtitle">Seasoned professionals with decades of cumulative real estate, revenue, and design acumen.</p>
            </div>

            <div class="team-grid">
                <% if (typeof leadership !== 'undefined' && leadership && leadership.length > 0) { %>
                    <% leadership.forEach(member => { %>
                    <div class="team-card">
                        <% if (member.photo_url) { %>
                        <div class="team-avatar" style="overflow: hidden; padding: 0;">
                            <img src="<%= member.photo_url %>" alt="<%= member.name %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\"fas fa-user-tie\"></i>';">
                        </div>
                        <% } else { %>
                        <div class="team-avatar">
                            <i class="fas <%= member.role_type === 'founder' || member.role_type === 'owner' ? 'fa-crown' : 'fa-user-tie' %>"></i>
                        </div>
                        <% } %>
                        <h3><%= member.name %></h3>
                        <span class="team-role"><%= member.designation %></span>
                        <p><%= member.bio %></p>
                        <% if (member.linkedin_url) { %>
                        <a href="<%= member.linkedin_url %>" target="_blank" rel="noopener noreferrer" style="color: var(--gold); font-size: 0.85rem; margin-top: 10px; display: inline-block;">
                            <i class="fab fa-linkedin"></i> Connect on LinkedIn
                        </a>
                        <% } %>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div class="team-card">
                        <div class="team-avatar"><i class="fas fa-crown"></i></div>
                        <h3>B. Bhuvan Raju</h3>
                        <span class="team-role">Founder</span>
                        <p>Visionary founder guiding SV Real Estates with over two decades of land acquisition, development excellence, and trusted property leadership across Hyderabad.</p>
                    </div>
                    <div class="team-card">
                        <div class="team-avatar"><i class="fas fa-user-tie"></i></div>
                        <h3>D. Manikanta</h3>
                        <span class="team-role">Managing Director</span>
                        <p>Leading executive operations, client advisory, luxury acquisitions, and project delivery with end-to-end transparency and verified compliance.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-banner-section">
        <div class="container">
            <div class="cta-banner-card">
                <div class="cta-text">
                    <h2>Experience the SV Real Estates Difference</h2>
                    <p>Whether you are acquiring a prime HMDA plot or designing your dream home interior, speak directly with our senior advisors.</p>
                </div>
                <div class="cta-buttons">
                    <button type="button" class="btn btn-gold btn-large" onclick="openEnquiryModal()">
                        <i class="fas fa-envelope"></i> Enquire Now
                    </button>
                    <a href="https://wa.me/<%= businessWhatsapp %>" target="_blank" class="btn btn-whatsapp btn-large">
                        <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/enquiry-modal') %>
    <%- include('../partials/chatbot') %>

    <script src="/js/main.js"></script>
    <script src="/js/chatbot.js"></script>
</body>
</html>
