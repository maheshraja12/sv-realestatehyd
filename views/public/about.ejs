<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="About SV Real Estates Hyderabad — Over 15 years of excellence in verified luxury real estate, open plots, and commercial developments across Telangana.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="site-body">
    <%- include('../partials/header') %>

    <!-- Page Banner -->
    <section class="page-banner">
        <div class="container page-banner-inner">
            <span class="page-tag"><i class="fas fa-crown text-gold"></i> ESTABLISHED LEGACY • ALL OVER HYDERABAD</span>
            <h1 class="page-title">About <span class="gold-gradient-text"><%= businessName %></span></h1>
            <p class="page-subtitle">Hyderabad's benchmark in building construction materials, supply chain reliability, and high-integrity real estate solutions all over Hyderabad.</p>
        </div>
    </section>

    <!-- Brand Story Section -->
    <section class="section about-story-section">
        <div class="container">
            <div class="about-story-grid">
                <div class="about-text-col">
                    <span class="section-badge">OUR FOUNDATION</span>
                    <h2 class="section-title">A Legacy Built on <span class="gold-gradient-text">Uncompromising Trust</span></h2>
                    <p class="story-lead">
                        Founded with a steadfast mission to serve construction and property needs in Telangana, <strong><%= businessName %></strong> stands as a symbol of quality materials, legal precision, and customer-first service.
                    </p>
                    <p>
                        Over the past decade and a half, Hyderabad has transformed into one of India’s most dynamic global business capitals. As the IT corridor, Outer Ring Road (ORR), and Regional Ring Road (RRR) opened up unprecedented wealth creation avenues, our team has helped thousands of families and NRI investors identify secure, high-yield plots, luxury villas, and prime commercial parcels all over Hyderabad.
                    </p>
                    <p>
                        We operate on an unwavering philosophy: <em>Every square yard we recommend must pass the exact rigorous title scrutiny we would demand for our own families.</em>
                    </p>

                    <div class="story-highlights-row">
                        <div class="story-hl">
                            <span class="hl-num">15+</span>
                            <span class="hl-lbl">Years of Excellence</span>
                        </div>
                        <div class="story-hl">
                            <span class="hl-num">500+</span>
                            <span class="hl-lbl">Acres Developed</span>
                        </div>
                        <div class="story-hl">
                            <span class="hl-num">3,200+</span>
                            <span class="hl-lbl">Satisfied Clients</span>
                        </div>
                    </div>
                </div>

                <div class="about-visual-col">
                    <div class="visual-box-card">
                        <div class="gold-frame-decor"></div>
                        <div class="visual-content">
                            <div class="brand-monogram-large">SV</div>
                            <h3>The Gold Standard in Telangana Real Estate</h3>
                            <ul class="check-list">
                                <li><i class="fas fa-check-circle text-gold"></i> 30-Year Comprehensive Title Search</li>
                                <li><i class="fas fa-check-circle text-gold"></i> 100% HMDA / RERA / DTCP Approved Layouts</li>
                                <li><i class="fas fa-check-circle text-gold"></i> Zero Litigation & Clean Link Deeds Guarantee</li>
                                <li><i class="fas fa-check-circle text-gold"></i> End-to-End Registration & Revenue Support</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values Section -->
    <section class="section core-values-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">OUR CODE</span>
                <h2 class="section-title">Core Principles That <span class="gold-gradient-text">Guide Us</span></h2>
                <p class="section-subtitle">Values that distinguish our practice in an evolving real estate market.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-balance-scale text-gold"></i></div>
                    <h3>Radical Transparency</h3>
                    <p>No artificial price markups, concealed encumbrances, or misleading timelines. We lay out full legal records and market comps upfront.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-shield-halved text-gold"></i></div>
                    <h3>Legal Due Diligence</h3>
                    <p>Our in-house panel of high court revenue advocates and property legal experts thoroughly examine every survey number before listing.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-chart-pie text-gold"></i></div>
                    <h3>Wealth Appreciation</h3>
                    <p>We analyze infrastructure blueprints, metro extensions, and SEZ zones to locate properties positioned for exponential 5-10 year appreciation.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-hand-holding-heart text-gold"></i></div>
                    <h3>Lifelong Partnership</h3>
                    <p>Our commitment doesn't end at registration. We assist clients with demarcation, boundary protection, mutation, and future resale management.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Leadership Section -->
    <section class="section team-section">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-badge">LEADERSHIP</span>
                <h2 class="section-title">Meet Our <span class="gold-gradient-text">Executive Team</span></h2>
                <p class="section-subtitle">Seasoned professionals with decades of cumulative real estate and revenue acumen.</p>
            </div>

            <div class="team-grid">
                <div class="team-card">
                    <div class="team-avatar"><i class="fas fa-user-tie"></i></div>
                    <h3>S. Venkatesh Reddy</h3>
                    <span class="team-role">Founder & Managing Director</span>
                    <p>Over two decades of land acquisition and luxury project development experience all over Hyderabad and Telangana.</p>
                </div>

                <div class="team-card">
                    <div class="team-avatar"><i class="fas fa-user-graduate"></i></div>
                    <h3>Adv. P. R. Sharma</h3>
                    <span class="team-role">Chief Legal Counsel & Title Officer</span>
                    <p>Senior advocate specializing in Telangana land revenue laws, RERA compliances, and 30-year ancestral link document audits.</p>
                </div>

                <div class="team-card">
                    <div class="team-avatar"><i class="fas fa-briefcase"></i></div>
                    <h3>Rajesh Varma</h3>
                    <span class="team-role">Head of NRI & Luxury Portfolio</span>
                    <p>Advising high-net-worth NRI families in USA, UAE, and Europe on high-appreciation gated community plots and triplex villas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-banner-section">
        <div class="container">
            <div class="cta-banner-card">
                <div class="cta-text">
                    <h2>Experience the SV Real Estates Difference</h2>
                    <p>Whether you seek a generational villa or an investment plot in Kokapet, our senior team is at your service.</p>
                </div>
                <div class="cta-buttons">
                    <button type="button" class="btn btn-gold btn-large" onclick="openConsultationModal('Executive Callback')">
                        <i class="fas fa-calendar-check"></i> Book Personal Consultation
                    </button>
                    <a href="https://wa.me/<%= businessWhatsapp %>" target="_blank" class="btn btn-whatsapp btn-large">
                        <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/enquiry-modal') %>

    <!-- Scripts -->
    <script src="/js/main.js"></script>
</body>
</html>
