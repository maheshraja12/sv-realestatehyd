<header class="site-header" id="siteHeader">
    <div class="header-topbar">
        <div class="container topbar-inner">
            <div class="topbar-left">
                <span><i class="fas fa-map-marker-alt text-gold"></i> Office: KPHB Colony, Kukatpally • Serving All Over Hyderabad</span>
                <span class="topbar-sep">•</span>
                <a href="mailto:<%= businessEmail %>"><i class="fas fa-envelope text-gold"></i> <%= businessEmail %></a>
            </div>
            <div class="topbar-right">
                <a href="<%= typeof businessInstagram !== 'undefined' && businessInstagram ? businessInstagram : 'https://instagram.com/sv.realestatehyd?cplk=MWtva2tubm11NDB0Ng%3D%3D&utm_source=qr' %>" target="_blank" rel="noopener noreferrer" class="topbar-link" title="Follow on Instagram"><i class="fab fa-instagram text-gold"></i> @sv.realestatehyd</a>
                <a href="tel:<%= businessPhone %>" class="topbar-link"><i class="fas fa-phone-alt text-gold"></i> <%= businessPhone %></a>
                <a href="https://wa.me/<%= businessWhatsapp %>" target="_blank" class="topbar-link text-whatsapp"><i class="fab fa-whatsapp"></i> Chat on WhatsApp</a>
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <% if (currentUser.isSuperAdmin) { %>
                    <a href="/admin/dashboard" class="topbar-admin-badge"><i class="fas fa-crown text-gold"></i> Super Admin</a>
                    <% } else { %>
                    <a href="/admin/leads" class="topbar-admin-badge"><i class="fas fa-users"></i> Staff Portal</a>
                    <% } %>
                <% } else { %>
                <a href="/admin/login" class="topbar-link text-muted"><i class="fas fa-lock"></i> Staff Login</a>
                <% } %>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="container header-inner">
            <a href="/" class="brand-logo">
                <div class="logo-symbol">
                    <span class="gold-monogram">SV</span>
                </div>
                <div class="brand-text">
                    <span class="brand-title"><%= businessName %></span>
                    <span class="brand-subtitle"><%= typeof businessTagline !== 'undefined' ? businessTagline : 'Building Construction & Materials Supplier' %></span>
                </div>
            </a>

            <nav class="main-nav" id="mainNav">
                <ul class="nav-links">
                    <li><a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a></li>
                    <li><a href="/properties" class="<%= path.startsWith('/properties') ? 'active' : '' %>">Properties</a></li>
                    <li><a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About Us</a></li>
                    <li><a href="/services" class="<%= path === '/services' ? 'active' : '' %>">Services</a></li>
                    <li><a href="/locations" class="<%= path === '/locations' ? 'active' : '' %>">Locations</a></li>
                    <li><a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact Us</a></li>
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <% if (currentUser.isSuperAdmin) { %>
                        <li><a href="/admin/dashboard" class="<%= path.startsWith('/admin') ? 'active' : '' %>" style="color:var(--gold); font-weight:700;"><i class="fas fa-crown"></i> Admin</a></li>
                        <% } else { %>
                        <li><a href="/admin/leads" class="<%= path.startsWith('/admin') ? 'active' : '' %>" style="color:var(--gold); font-weight:700;"><i class="fas fa-users"></i> Leads</a></li>
                        <% } %>
                    <% } %>
                </ul>
            </nav>

            <div class="header-actions">
                <button type="button" class="btn btn-gold btn-header-cta" onclick="openEnquiryModal()">
                    <i class="fas fa-envelope"></i> Enquire Now
                </button>
                <button class="mobile-toggle" id="mobileNavToggle" onclick="toggleMobileNav()" aria-label="Toggle menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </div>
</header>
