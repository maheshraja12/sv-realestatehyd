<!-- Universal Shared Enquiry & Appointment Modal -->
<div class="modal-backdrop-custom" id="enquiryModalBackdrop" style="display:none;" onclick="closeEnquiryModal(event)"></div>
<div class="modal-wrapper-custom" id="enquiryModal" style="display:none;" onclick="handleModalWrapperClick(event)">
    <div class="modal-dialog-custom" onclick="event.stopPropagation()">
        <button type="button" class="modal-close-btn" id="modalCloseBtn" onclick="closeEnquiryModal(event)" aria-label="Close dialog" title="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none;" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        
        <div class="modal-header-custom">
            <span class="modal-tag" id="modalBadge">DIRECT ENQUIRY</span>
            <h3 id="modalTitle">Enquire & Schedule Visit</h3>
            <p id="modalSubtitle" class="text-muted">Connect directly with our senior property consultant in Hyderabad.</p>
        </div>

        <!-- Property Preview (if opened from a specific property listing) -->
        <div id="modalPropertyPreview" class="modal-property-card" style="display:none;">
            <i class="fas fa-building text-gold fa-2x"></i>
            <div class="modal-property-meta">
                <strong id="modalPropTitle">Property Title</strong>
                <span id="modalPropCode" class="text-gold">Code</span>
            </div>
        </div>

        <!-- Error State Alert -->
        <div id="modalErrorAlert" class="alert-error-custom" style="display:none; background:rgba(239,68,68,0.15); border:1px solid #ef4444; color:#fca5a5; padding:10px 14px; border-radius:6px; font-size:0.85rem; margin-bottom:14px;">
            <i class="fas fa-exclamation-circle"></i> <span id="modalErrorText">Please fill in all required fields.</span>
        </div>

        <form id="publicEnquiryForm" action="javascript:void(0);" method="POST" onsubmit="event.preventDefault(); return handlePublicEnquirySubmit(event);">
            <input type="hidden" id="modalPropertyId" name="property_id" value="">

            <div class="form-grid-modal">
                <!-- 1. Full Name -->
                <div class="form-group-modal full-width">
                    <label for="modalCustomerName"><i class="fas fa-user text-gold"></i> Full Name *</label>
                    <input type="text" id="modalCustomerName" name="full_name" required placeholder="Enter your full name" autocomplete="name">
                </div>

                <!-- 2. Phone Number -->
                <div class="form-group-modal full-width">
                    <label for="modalPhone"><i class="fas fa-phone-alt text-gold"></i> Phone Number *</label>
                    <input type="tel" id="modalPhone" name="phone_number" required placeholder="10-digit mobile number (e.g. 9876543210)" autocomplete="tel" pattern="[0-9+ -]{10,15}">
                </div>

                <!-- 3. Preferred Appointment Date & Time -->
                <div class="form-group-modal">
                    <label for="modalAppointmentDate"><i class="fas fa-calendar-day text-gold"></i> Preferred Appointment Date *</label>
                    <input type="date" id="modalAppointmentDate" name="appointment_date" required>
                </div>

                <div class="form-group-modal">
                    <label for="modalAppointmentTime"><i class="fas fa-clock text-gold"></i> Appointment Time Slot *</label>
                    <select id="modalAppointmentTime" name="appointment_time" required>
                        <option value="">Select Time Slot *</option>
                        <option value="10:00 AM - 12:00 PM">10:00 AM - 12:00 PM (Morning)</option>
                        <option value="12:00 PM - 02:00 PM">12:00 PM - 02:00 PM (Afternoon)</option>
                        <option value="02:00 PM - 04:00 PM">02:00 PM - 04:00 PM (Post-Lunch)</option>
                        <option value="04:00 PM - 06:00 PM">04:00 PM - 06:00 PM (Evening)</option>
                        <option value="06:00 PM - 08:00 PM">06:00 PM - 08:00 PM (Late Evening)</option>
                    </select>
                </div>

                <!-- 4. What Are You Looking For? -->
                <div class="form-group-modal full-width">
                    <label for="modalPropertyRequirement"><i class="fas fa-home text-gold"></i> What Are You Looking For? *</label>
                    <select id="modalPropertyRequirement" name="property_requirement" required>
                        <option value="">Select Property Type *</option>
                        <option value="Residential Plot">Residential Plot</option>
                        <option value="Villa">Villa</option>
                        <option value="Apartment">Apartment</option>
                        <option value="Commercial Property">Commercial Property</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <!-- Submit and Cancel Buttons -->
            <div class="modal-footer-custom modal-actions-grid" style="margin-top:20px; display:flex; gap:12px; align-items:center;">
                <button type="button" id="modalCancelBtn" class="btn btn-cancel-custom" onclick="closeEnquiryModal(event)" title="Cancel and close dialog">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" id="modalSubmitBtn" class="btn btn-gold btn-large" style="flex:1;">
                    <i class="fas fa-paper-plane"></i> <span id="submitBtnText">Submit Enquiry</span>
                </button>
            </div>
        </form>

        <!-- Luxury Thank You Greeting Card -->
        <div id="modalSuccess" class="modal-success-state" style="display:none;">
            <div class="greeting-icon-wrapper">
                <i class="fas fa-check"></i>
            </div>
            <span class="greeting-badge"><i class="fas fa-crown text-gold"></i> ENQUIRY CONFIRMED</span>
            <h2 class="greeting-title">Thank You, <span class="gold-gradient-text" id="greetingCustomerName">Valued Client</span>!</h2>
            <p class="greeting-subtitle" id="successMessageText">Your details have been received by our senior property team. We look forward to connecting with you.</p>

            <div class="greeting-ref-card">
                <div class="greeting-ref-header">
                    <span class="greeting-ref-label"><i class="fas fa-ticket-alt text-gold"></i> Booking Reference</span>
                    <button type="button" class="btn-copy-ref" onclick="copyReferenceCode()" title="Copy Reference Code">
                        <i class="fas fa-copy"></i> <span id="copyBtnLabel">Copy</span>
                    </button>
                </div>
                <div class="greeting-ref-code" id="successRefCode">SV-LEAD-XXXXXX</div>
                <div class="greeting-meta-grid">
                    <div class="meta-item">
                        <i class="fas fa-calendar-check text-gold"></i>
                        <div>
                            <small>Appointment Slot</small>
                            <strong id="greetingDateSlot">Confirmed</strong>
                        </div>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-city text-gold"></i>
                        <div>
                            <small>Looking For</small>
                            <strong id="greetingRequirement">Property Details</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="greeting-steps">
                <div class="step-pill"><i class="fas fa-shield-alt text-gold"></i> Verified Title Assurance</div>
                <div class="step-pill"><i class="fas fa-user-tie text-gold"></i> Senior Consultant</div>
                <div class="step-pill"><i class="fas fa-map-marker-alt text-gold"></i> All Over Hyderabad</div>
            </div>

            <div class="greeting-actions">
                <a id="successWhatsAppLink" href="#" target="_blank" class="btn btn-whatsapp btn-large">
                    <i class="fab fa-whatsapp"></i> Chat on WhatsApp
                </a>
                <button type="button" class="btn btn-gold btn-large" onclick="closeEnquiryModal(event)">
                    <i class="fas fa-arrow-left"></i> Back to Main Page
                </button>
            </div>
        </div>
    </div>
</div>
