<!-- ==========================================================================
     SV REAL ESTATES HYDERABAD — 3D LIQUID GLASS LAUNCH EXPERIENCE
     ========================================================================== -->
<% 
const isOverlayEnabled = (typeof settings !== 'undefined' && settings.launch_overlay_enabled) ? settings.launch_overlay_enabled : '1';
const isAdminPreview = (typeof adminLaunchPreview !== 'undefined' && adminLaunchPreview);
const shouldRenderOverlay = (isOverlayEnabled !== '0') || isAdminPreview;
%>

<% if (shouldRenderOverlay) { %>
<div id="launchOverlay"
     class="launch-overlay is-active"
     data-enabled="<%= isOverlayEnabled %>"
     data-admin-preview="<%= isAdminPreview ? '1' : '0' %>"
     data-liquid-effects="<%= (typeof settings !== 'undefined' && typeof settings.launch_liquid_effects_enabled !== 'undefined') ? settings.launch_liquid_effects_enabled : '1' %>"
     data-mode="<%= (typeof settings !== 'undefined' && settings.launch_overlay_mode) ? settings.launch_overlay_mode : 'always' %>"
     role="dialog"
     aria-modal="true"
     aria-labelledby="launchHeading"
     aria-describedby="launchSubHeading">

    <!-- Atmospheric Caustics Background -->
    <div class="launch-bg" aria-hidden="true">
        <div class="launch-bg-glow launch-bg-glow-gold"></div>
        <div class="launch-bg-glow launch-bg-glow-ambient"></div>
    </div>

    <!-- SVG Optical Refraction Filters -->
    <svg style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
        <filter id="liquidGlassRefraction">
            <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </svg>

    <!-- 2D Waterdrop Simulation Canvas -->
    <canvas id="launchWaterdropCanvas" class="launch-waterdrop-canvas" aria-hidden="true"></canvas>

    <!-- Accessibility: Screen Reader Live Announcements for Countdown -->
    <div id="launchSrAnnouncements" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

    <!-- Central Glass Stage -->
    <div class="launch-stage-wrapper">
        <div class="liquid-glass-card">

            <!-- STAGE 1: Premium Welcome Screen -->
            <div id="launchWelcomeStage" class="launch-stage-content">
                <div class="launch-brand-badge">
                    <i class="fas fa-crown text-gold"></i>
                    <span>SV Real Estates Hyderabad</span>
                </div>
                <h1 id="launchHeading" class="launch-main-title">
                    THE ART OF <span class="gold-shimmer">BETTER LIVING</span>
                </h1>
                <p id="launchSubHeading" class="launch-subtitle">
                    Discover a world of exceptional properties and refined living.
                </p>

                <!-- Central 3D Glass Orb Stage -->
                <div id="launchOrbStage" class="launch-orb-stage">
                    <div id="launchOrbThreeContainer" class="orb-three-container">
                        <div id="launchWebglCanvas"></div>
                    </div>
                    <div class="glass-sphere-orb">
                        <div id="orbLiquidRipple" class="orb-liquid-ripple"></div>
                        <div id="orbIdleMonogram" class="orb-idle-monogram">
                            <div class="monogram-circle">SV</div>
                        </div>
                        <div id="orbNumberDisplay" class="orb-number-display" style="display: none;" aria-hidden="true">10</div>
                    </div>
                </div>

                <!-- Only ONE primary button: START EXPERIENCE -->
                <div class="launch-actions-row">
                    <button type="button" id="btnLaunchStart" class="btn-liquid-glass btn-liquid-primary" aria-label="Start Website Launch Experience">
                        <i class="fas fa-play"></i> START EXPERIENCE
                    </button>
                </div>
            </div>

            <!-- STAGE 3: Grand Launch Reveal Screen (Revealed at zero) -->
            <div id="launchLiveStage" class="launch-live-stage" style="display: none;">
                <div class="live-badge">
                    <span>Grand Unveiling</span>
                </div>
                <h2 class="live-hero-title">
                    WE ARE <span class="gold-shimmer">LIVE</span>
                </h2>
                <p class="launch-subtitle">
                    Your next chapter begins here.
                </p>

                <!-- Only ONE primary button: EXPLORE WEBSITE -->
                <div class="launch-actions-row" style="margin-top: 28px;">
                    <button type="button" id="btnLaunchExplore" class="btn-liquid-glass btn-liquid-primary js-launch-explore" aria-label="Explore Website Homepage">
                        EXPLORE WEBSITE <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- Expanding Zero Ripple Shockwave -->
    <div id="launchZeroShockwave" class="launch-zero-shockwave" aria-hidden="true"></div>
</div>

<!-- Three.js (local fallback with CDN support) -->
<script src="/js/vendor/three.min.js"></script>
<!-- Launch 3D Liquid Glass Engine -->
<script src="/js/launch-liquid-glass.js"></script>
<% } %>
