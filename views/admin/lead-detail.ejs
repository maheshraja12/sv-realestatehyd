<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <%- include('../partials/admin-sidebar') %>
    
    <main class="admin-main">
        <header class="admin-header">
            <div class="header-left">
                <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <h2>Lead: <%= lead.customer_name %></h2>
            </div>
            <div class="header-right">
                <a href="/admin/leads" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </header>

        <div class="admin-content">
            <div class="lead-detail-grid">
                <!-- Left: Lead Info -->
                <div class="lead-main">
                    <!-- Customer Info -->
                    <div class="detail-card">
                        <h3><i class="fas fa-user"></i> Customer Information</h3>
                        <div class="detail-grid">
                            <div class="detail-item"><label>Full Name</label><span><strong><%= lead.full_name || lead.customer_name %></strong></span></div>
                            <div class="detail-item"><label>Phone Number</label><span><a href="tel:<%= lead.phone_number || lead.phone %>" style="color:var(--gold); font-weight:700;"><%= lead.phone_number || lead.phone %></a></span></div>
                            <div class="detail-item"><label>Email</label><span><%= lead.email || '—' %></span></div>
                            <div class="detail-item"><label>Preferred Appointment Date</label><span><strong><%= formatDate(lead.appointment_date || lead.preferred_visit_date) %></strong></span></div>
                            <div class="detail-item"><label>Appointment Time Slot</label><span><span class="badge" style="background:rgba(212,175,55,0.15); color:var(--gold); padding:4px 8px; border-radius:4px;"><%= lead.appointment_time || '10:00 AM - 12:00 PM' %></span></span></div>
                            <div class="detail-item"><label>Property Looking For</label><span><span class="badge-type-meet"><%= lead.property_requirement || lead.property_category || 'Residential Plot' %></span></span></div>
                        </div>
                        <div class="detail-actions">
                            <a href="tel:<%= lead.phone_number || lead.phone %>" class="btn btn-success"><i class="fas fa-phone"></i> Call Customer</a>
                            <a href="https://wa.me/<%= String(lead.phone_number || lead.phone).replace(/[^0-9]/g, '') %>" target="_blank" class="btn btn-whatsapp"><i class="fab fa-whatsapp"></i> Chat on WhatsApp</a>
                            <% if (lead.email) { %>
                            <a href="mailto:<%= lead.email %>" class="btn btn-secondary"><i class="fas fa-envelope"></i> Email</a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Enquiry Details -->
                    <div class="detail-card">
                        <h3><i class="fas fa-clipboard text-gold"></i> Appointment & Enquiry Details</h3>
                        <div class="detail-grid">
                            <div class="detail-item"><label>Reference Code</label><span><strong><%= lead.lead_code %></strong></span></div>
                            <div class="detail-item"><label>Customer Name</label><span><strong><%= lead.full_name || lead.customer_name %></strong></span></div>
                            <div class="detail-item">
                                <label>Phone Number</label>
                                <span>
                                    <a href="tel:<%= lead.phone_number || lead.phone %>" style="color:var(--gold); font-weight:700; text-decoration:none;">
                                        <i class="fas fa-phone"></i> <%= lead.phone_number || lead.phone %>
                                    </a>
                                </span>
                            </div>
                            <div class="detail-item highlight-location">
                                <label><i class="fas fa-home text-primary"></i> Looking For (Requirement)</label>
                                <span>
                                    <span class="badge-location-lg">
                                        <i class="fas fa-building"></i> <%= lead.property_requirement || lead.property_category || 'Residential Plot' %>
                                    </span>
                                </span>
                            </div>
                            <div class="detail-item highlight-date">
                                <label><i class="fas fa-calendar-check text-gold"></i> Appointment Date & Time</label>
                                <span>
                                    <% if (lead.appointment_date || lead.preferred_visit_date) { %>
                                    <span class="badge-visit-date-lg"><i class="fas fa-calendar-day"></i> <%= formatDate(lead.appointment_date || lead.preferred_visit_date) %> (<%= lead.appointment_time || '10:00 AM - 12:00 PM' %>)</span>
                                    <% } else { %>
                                    <span class="text-muted">Immediate</span>
                                    <% } %>
                                </span>
                            </div>
                            <div class="detail-item"><label>Property Attached</label><span><%= lead.property_title || 'General Enquiry (No specific listing)' %></span></div>
                            <div class="detail-item"><label>Source</label><span class="source-badge"><%= lead.source %></span></div>
                            <div class="detail-item"><label>Submission Date</label><span><strong><%= formatDateTime(lead.created_at) %></strong></span></div>
                        </div>
                        <% if (lead.message) { %>
                        <div class="message-box">
                            <label>Customer Message:</label>
                            <p><%= lead.message %></p>
                        </div>
                        <% } %>
                    </div>

                    <!-- Communication Log / Notes -->
                    <div class="detail-card">
                        <h3><i class="fas fa-comments"></i> Notes & Communication Log</h3>
                        <form id="addNoteForm" class="note-form">
                            <div class="form-row">
                                <textarea id="noteText" placeholder="Add a note..." rows="2" required></textarea>
                            </div>
                            <div class="form-row note-actions">
                                <select id="noteType">
                                    <option value="note">Note</option>
                                    <option value="call">Phone Call</option>
                                    <option value="email">Email</option>
                                    <option value="whatsapp">WhatsApp</option>
                                </select>
                                <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Note</button>
                            </div>
                        </form>
                        <div class="notes-list" id="notesList">
                            <% if (notes.length === 0) { %>
                            <p class="empty-state">No notes yet</p>
                            <% } %>
                            <% notes.forEach(note => { %>
                            <div class="note-item note-type-<%= note.note_type %>">
                                <div class="note-header">
                                    <span class="note-type-badge"><%= note.note_type %></span>
                                    <span class="note-author"><%= note.user_name || 'System' %></span>
                                    <span class="note-date"><%= formatDateTime(note.created_at) %></span>
                                </div>
                                <p><%= note.note %></p>
                            </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Status History -->
                    <div class="detail-card">
                        <h3><i class="fas fa-history"></i> Status History</h3>
                        <div class="status-timeline">
                            <% statusHistory.forEach(h => { %>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <span class="status-badge status-<%= h.new_status %>"><%= h.new_status.replace(/_/g, ' ') %></span>
                                    <% if (h.old_status) { %>
                                    <small>from <%= h.old_status.replace(/_/g, ' ') %></small>
                                    <% } %>
                                    <small>by <%= h.changed_by_name || 'System' %> · <%= formatDateTime(h.created_at) %></small>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Appointments -->
                    <% if (appointments.length > 0) { %>
                    <div class="detail-card">
                        <h3><i class="fas fa-calendar"></i> Site Visits</h3>
                        <% appointments.forEach(apt => { %>
                        <div class="appointment-item">
                            <span class="status-badge status-<%= apt.status %>"><%= apt.status %></span>
                            <span><%= apt.requested_date %> <%= apt.requested_time || '' %></span>
                            <% if (apt.confirmed_date) { %><small>Confirmed: <%= apt.confirmed_date %></small><% } %>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <!-- Right Sidebar -->
                <div class="lead-sidebar">
                    <div class="sidebar-card">
                        <h4>Lead Status</h4>
                        <select id="leadStatus" class="filter-select" onchange="updateLeadStatusDetail(<%= lead.id %>, this.value)">
                            <option value="new" <%= lead.status === 'new' ? 'selected' : '' %>>New</option>
                            <option value="contacted" <%= lead.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                            <option value="interested" <%= lead.status === 'interested' ? 'selected' : '' %>>Interested</option>
                            <option value="site_visit_scheduled" <%= lead.status === 'site_visit_scheduled' ? 'selected' : '' %>>Site Visit Scheduled</option>
                            <option value="negotiation" <%= lead.status === 'negotiation' ? 'selected' : '' %>>Negotiation</option>
                            <option value="converted" <%= lead.status === 'converted' ? 'selected' : '' %>>Converted</option>
                            <option value="lost" <%= lead.status === 'lost' ? 'selected' : '' %>>Lost</option>
                            <option value="spam" <%= lead.status === 'spam' ? 'selected' : '' %>>Spam</option>
                        </select>
                    </div>

                    <div class="sidebar-card">
                        <h4>Assign Agent</h4>
                        <select id="assignAgent" class="filter-select" onchange="assignAgent(<%= lead.id %>, this.value)">
                            <option value="">Unassigned</option>
                            <% agents.forEach(agent => { %>
                            <option value="<%= agent.id %>" <%= lead.assigned_agent_id === agent.id ? 'selected' : '' %>><%= agent.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="sidebar-card">
                        <h4>Follow-up</h4>
                        <input type="date" id="followUpDate" class="filter-input" value="<%= lead.next_follow_up || '' %>" onchange="setFollowUp(<%= lead.id %>, this.value)">
                    </div>

                    <div class="sidebar-card">
                        <h4>Quick Actions</h4>
                        <div class="quick-actions">
                            <button onclick="updateLeadStatusDetail(<%= lead.id %>, 'converted')" class="btn btn-success btn-block"><i class="fas fa-trophy"></i> Mark Converted</button>
                            <button onclick="updateLeadStatusDetail(<%= lead.id %>, 'lost')" class="btn btn-ghost btn-block"><i class="fas fa-times"></i> Mark Lost</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/admin.js"></script>
    <script>
        const leadId = <%= lead.id %>;
        
        document.getElementById('addNoteForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const note = document.getElementById('noteText').value.trim();
            const noteType = document.getElementById('noteType').value;
            if (!note) return;

            try {
                const res = await fetch(`/api/leads/${leadId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ note, note_type: noteType })
                });
                if (res.ok) {
                    location.reload();
                } else {
                    showToast('Failed to add note', 'error');
                }
            } catch (err) {
                showToast('Error adding note', 'error');
            }
        });

        function updateLeadStatusDetail(id, status) {
            fetch(`/api/leads/${id}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            }).then(r => { if (r.ok) location.reload(); else showToast('Failed to update status', 'error'); });
        }

        function assignAgent(id, agentId) {
            fetch(`/api/leads/${id}/assign`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ agent_id: agentId || null })
            }).then(r => { if (r.ok) showToast('Agent assigned'); else showToast('Failed', 'error'); });
        }

        function setFollowUp(id, date) {
            fetch(`/api/leads/${id}/follow-up`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ next_follow_up: date || null })
            }).then(r => { if (r.ok) showToast('Follow-up date set'); else showToast('Failed', 'error'); });
        }
    </script>
</body>
</html>
