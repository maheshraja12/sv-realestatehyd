<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="admin-body">
    <%- include('../partials/admin-sidebar') %>
    
    <main class="admin-main">
        <header class="admin-header">
            <div class="header-left">
                <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <h2>Dashboard</h2>
            </div>
            <div class="header-right" style="display:flex; gap:12px; align-items:center;">
                <button type="button" onclick="window.location.reload()" class="btn btn-primary" style="background:var(--gold); color:#0c0f17; font-weight:700; cursor:pointer; padding:6px 14px; font-size:0.85rem;">
                    <i class="fas fa-sync-alt"></i> Refresh Dashboard
                </button>
                <div class="notification-bell" onclick="toggleNotifications()">
                    <i class="fas fa-bell"></i>
                    <% if (unreadNotifications > 0) { %>
                    <span class="badge"><%= unreadNotifications %></span>
                    <% } %>
                </div>
                <div class="notification-dropdown" id="notificationDropdown" style="display:none;">
                    <div class="notif-header">
                        <h4>Notifications</h4>
                        <button onclick="markAllRead()" class="btn-text">Mark all read</button>
                    </div>
                    <div id="notificationList" class="notif-list"></div>
                </div>
                <span class="user-name"><%= currentUser.name %></span>
            </div>
        </header>

        <div class="dashboard-content">
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#667eea,#764ba2)"><i class="fas fa-building"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.totalProperties %></span>
                        <span class="stat-label">Total Properties</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#11998e,#38ef7d)"><i class="fas fa-check-circle"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.publishedProperties %></span>
                        <span class="stat-label">Published</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#f093fb,#f5576c)"><i class="fas fa-file-alt"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.draftProperties %></span>
                        <span class="stat-label">Drafts</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#4facfe,#00f2fe)"><i class="fas fa-users"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.totalLeads %></span>
                        <span class="stat-label">Total Enquiries</span>
                    </div>
                </div>
                <div class="stat-card highlight">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#fa709a,#fee140)"><i class="fas fa-star"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.newLeads %></span>
                        <span class="stat-label">New Enquiries</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#a18cd1,#fbc2eb)"><i class="fas fa-phone"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.followUpsDue %></span>
                        <span class="stat-label">Follow-ups Due</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#ffecd2,#fcb69f)"><i class="fas fa-calendar-check"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.siteVisitsScheduled %></span>
                        <span class="stat-label">Site Visits</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:linear-gradient(135deg,#43e97b,#38f9d7)"><i class="fas fa-trophy"></i></div>
                    <div class="stat-info">
                        <span class="stat-number"><%= stats.closedLeads %></span>
                        <span class="stat-label">Converted</span>
                    </div>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="charts-grid">
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fas fa-chart-line text-gold"></i> Enquiries Over Time</h3>
                        <span class="text-muted" style="font-size:0.8rem;">Last 30 Days</span>
                    </div>
                    <div class="chart-container-box">
                        <canvas id="leadsOverTimeChart"></canvas>
                    </div>
                </div>
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fas fa-chart-pie text-gold"></i> Lead Status Distribution</h3>
                        <span class="text-muted" style="font-size:0.8rem;">Current CRM Pipeline</span>
                    </div>
                    <div class="chart-container-box">
                        <canvas id="leadStatusChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="charts-grid">
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fas fa-layer-group text-gold"></i> Enquiries by Category</h3>
                        <span class="text-muted" style="font-size:0.8rem;">Customer Demand</span>
                    </div>
                    <div class="chart-container-box">
                        <canvas id="leadsByCategoryChart"></canvas>
                    </div>
                </div>
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fas fa-city text-gold"></i> Properties by Category</h3>
                        <span class="text-muted" style="font-size:0.8rem;">Inventory Breakdown</span>
                    </div>
                    <div class="chart-container-box">
                        <canvas id="propertiesByCategoryChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="activity-grid">
                <div class="activity-card">
                    <div class="activity-header">
                        <h3><i class="fas fa-user-clock text-gold"></i> Recent Enquiries</h3>
                        <a href="/admin/leads" class="btn-text">View All →</a>
                    </div>
                    <div class="activity-list">
                        <% if (recentLeads.length === 0) { %>
                        <p class="empty-state">No enquiries yet</p>
                        <% } %>
                        <% recentLeads.forEach(lead => { %>
                        <a href="/admin/leads/<%= lead.id %>" class="activity-item">
                            <div class="activity-icon"><i class="fas fa-user"></i></div>
                            <div class="activity-info">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <strong><%= lead.full_name || lead.customer_name %></strong>
                                    <% if (lead.phone_number || lead.phone) { %>
                                    <span style="color:var(--gold); font-size:0.85rem;"><i class="fas fa-phone-alt"></i> <%= lead.phone_number || lead.phone %></span>
                                    <% } %>
                                </div>
                                <div style="display:flex; flex-wrap:wrap; gap:6px; margin: 4px 0;">
                                    <span class="badge-type-meet" style="font-size:0.75rem;">
                                        <i class="fas fa-home"></i> <%= lead.property_requirement || lead.property_category || 'Residential Plot' %>
                                    </span>
                                    <% if (lead.appointment_time) { %>
                                    <span class="badge" style="background:rgba(212,175,55,0.12); color:var(--gold); font-size:0.72rem; padding:2px 6px; border-radius:4px;">
                                        <i class="fas fa-clock"></i> <%= lead.appointment_time %>
                                    </span>
                                    <% } %>
                                </div>
                                <% if (lead.appointment_date || lead.preferred_visit_date) { %>
                                <div>
                                    <span class="badge-visit-date" style="font-size:0.75rem;">
                                        <i class="fas fa-calendar-day"></i> Appointment: <strong><%= formatDate(lead.appointment_date || lead.preferred_visit_date) %></strong>
                                    </span>
                                </div>
                                <% } %>
                                <small class="text-muted"><%= lead.lead_code %> · Submitted: <%= formatDateTime(lead.created_at) %></small>
                            </div>
                            <span class="status-badge status-<%= lead.status %>"><%= lead.status.replace(/_/g, ' ') %></span>
                        </a>
                        <% }) %>
                    </div>
                </div>
                <div class="activity-card">
                    <div class="activity-header">
                        <h3><i class="fas fa-home"></i> Recently Updated Properties</h3>
                        <a href="/admin/properties" class="btn-text">View All →</a>
                    </div>
                    <div class="activity-list">
                        <% if (recentProperties.length === 0) { %>
                        <p class="empty-state">No properties yet. <a href="/admin/properties/new">Add your first property</a></p>
                        <% } %>
                        <% recentProperties.forEach(prop => { %>
                        <a href="/admin/properties/<%= prop.id %>/edit" class="activity-item">
                            <div class="activity-icon"><i class="fas fa-building"></i></div>
                            <div class="activity-info">
                                <strong><%= prop.title %></strong>
                                <span><%= prop.property_code %> · <%= prop.locality || prop.city %></span>
                            </div>
                            <span class="status-badge status-<%= prop.status %>"><%= prop.status %></span>
                        </a>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/admin.js"></script>
    <script src="/js/charts.js"></script>
</body>
</html>
