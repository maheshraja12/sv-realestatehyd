<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <%- include('../partials/admin-sidebar') %>
    
    <main class="admin-main">
        <header class="admin-header">
            <div class="header-left">
                <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <h2>Settings</h2>
            </div>
            <div class="header-right">
                <div class="notification-bell" onclick="toggleNotifications()">
                    <i class="fas fa-bell"></i>
                    <% if (unreadNotifications > 0) { %>
                    <span class="badge"><%= unreadNotifications %></span>
                    <% } %>
                </div>
                <span class="user-name"><%= currentUser ? currentUser.name : 'Admin' %></span>
            </div>
        </header>

        <div class="admin-content">
            <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
            <% } %>

            <div class="settings-grid">
                <!-- Super Admin Role & Permission Controls -->
                <div class="settings-card" style="border: 1px solid rgba(212, 175, 55, 0.4); box-shadow: 0 4px 20px rgba(212, 175, 55, 0.08);">
                    <div class="card-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 14px; margin-bottom: 18px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <h3><i class="fas fa-crown text-gold"></i> Normal Admin Permissions & Module Access</h3>
                            <span class="status-badge status-published" style="background:rgba(212,175,55,0.15); color:var(--gold); border:1px solid rgba(212,175,55,0.3); font-weight:700;">
                                <i class="fas fa-shield-alt"></i> Super Admin Only
                            </span>
                        </div>
                        <p style="margin-top:6px; color:#9aa0ac;">Control which tabs and options are visible to the Normal Admin. By default, Normal Admins only see and manage customer Leads & Enquiries.</p>
                    </div>

                    <form method="POST" action="/admin/settings/permissions" class="settings-form">
                        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
                            <h4 style="margin: 0 0 14px 0; color: #fff; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                                <i class="fas fa-toggle-on text-gold"></i> Visible Modules for Normal Admin
                            </h4>

                            <div style="display: flex; flex-direction: column; gap: 14px;">
                                <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer;">
                                    <input type="checkbox" name="perm_leads" value="1" checked disabled style="margin-top: 3px; accent-color: var(--gold);">
                                    <div>
                                        <strong style="color: #fff; font-size: 0.9rem;">Customer Leads & Enquiries</strong>
                                        <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #9aa0ac;">Always visible & active by default. Normal Admin handles all customer inquiries, status updates, and notes.</p>
                                    </div>
                                </label>

                                <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer;">
                                    <input type="checkbox" name="perm_dashboard" value="1" <%= (typeof adminPermissions !== 'undefined' && adminPermissions && adminPermissions.dashboard) ? 'checked' : '' %> style="margin-top: 3px; accent-color: var(--gold);">
                                    <div>
                                        <strong style="color: #fff; font-size: 0.9rem;">Dashboard & Analytics</strong>
                                        <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #9aa0ac;">Allow Normal Admin to view the analytics dashboard and summary stats cards.</p>
                                    </div>
                                </label>

                                <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer;">
                                    <input type="checkbox" name="perm_properties" value="1" <%= (typeof adminPermissions !== 'undefined' && adminPermissions && adminPermissions.properties) ? 'checked' : '' %> style="margin-top: 3px; accent-color: var(--gold);">
                                    <div>
                                        <strong style="color: #fff; font-size: 0.9rem;">Properties Catalog Management</strong>
                                        <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #9aa0ac;">Allow Normal Admin to add, edit, duplicate, and modify property listings.</p>
                                    </div>
                                </label>

                                <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer;">
                                    <input type="checkbox" name="perm_appointments" value="1" <%= (typeof adminPermissions !== 'undefined' && adminPermissions && adminPermissions.appointments) ? 'checked' : '' %> style="margin-top: 3px; accent-color: var(--gold);">
                                    <div>
                                        <strong style="color: #fff; font-size: 0.9rem;">Site Visits & Appointments</strong>
                                        <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #9aa0ac;">Allow Normal Admin to view and update customer site visit bookings.</p>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Normal Admin Account Credentials -->
                        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 18px; margin-bottom: 20px;">
                            <h4 style="margin: 0 0 14px 0; color: #fff; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                                <i class="fas fa-user-cog text-gold"></i> Normal Admin (Staff) Account Details
                            </h4>

                            <div class="form-row cols-2">
                                <div class="form-group">
                                    <label for="staff_name">Staff Admin Name</label>
                                    <input type="text" id="staff_name" name="staff_name" value="<%= (typeof staffUser !== 'undefined' && staffUser) ? staffUser.name : 'SV Staff Admin' %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="staff_email">Staff Admin Email Address</label>
                                    <input type="email" id="staff_email" name="staff_email" value="<%= (typeof staffUser !== 'undefined' && staffUser) ? staffUser.email : 'admin@svrealestate.com' %>" required>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom:0;">
                                <label for="staff_password">Change Staff Admin Password <span style="font-weight:normal; color:#9aa0ac;">(Leave blank to keep unchanged)</span></label>
                                <input type="password" id="staff_password" name="staff_password" placeholder="••••••••" minlength="6">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" style="background:var(--gold); color:#0c0f17; font-weight:700;">
                                <i class="fas fa-save"></i> Save Normal Admin Permissions & Account
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Business Profile Form -->
                <div class="settings-card">
                    <div class="card-header">
                        <h3><i class="fas fa-building text-gold"></i> Business Profile</h3>
                        <p>These details are displayed publicly on the website header, footer, and contact pages.</p>
                    </div>
                    <form method="POST" action="/admin/settings" class="settings-form">
                        <div class="form-group">
                            <label for="business_name">Business Name</label>
                            <input type="text" id="business_name" name="business_name" value="<%= settings.business_name || 'Sri Venkateswara Building Material Traders' %>" required>
                        </div>

                        <div class="form-row cols-2">
                            <div class="form-group">
                                <label for="business_phone">Contact Phone</label>
                                <input type="text" id="business_phone" name="business_phone" value="<%= settings.business_phone || '+91 9346423434' %>" required>
                            </div>
                            <div class="form-group">
                                <label for="business_whatsapp">WhatsApp Number (with country code)</label>
                                <input type="text" id="business_whatsapp" name="business_whatsapp" value="<%= settings.business_whatsapp || '919346423434' %>" placeholder="e.g. 919346423434" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="business_email">Official Email</label>
                            <input type="email" id="business_email" name="business_email" value="<%= settings.business_email || 'svsrivenkateswara99@gmail.com' %>" required>
                        </div>

                        <div class="form-group">
                            <label for="business_instagram">Instagram Profile URL</label>
                            <input type="url" id="business_instagram" name="business_instagram" value="<%= settings.business_instagram || 'https://instagram.com/sv.realestatehyd?cplk=MWtva2tubm11NDB0Ng%3D%3D&utm_source=qr' %>" placeholder="https://instagram.com/sv.realestatehyd">
                        </div>

                        <div class="form-group">
                            <label for="business_address">Office Address</label>
                            <textarea id="business_address" name="business_address" rows="3"><%= settings.business_address || '# MIG-2/183, 9th Phase, KPHB Colony, Kukatpally, Hyderabad - 500085' %></textarea>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Business Details</button>
                        </div>
                    </form>
                </div>

                <!-- SMTP & Email Settings -->
                <div class="settings-card">
                    <div class="card-header">
                        <h3><i class="fas fa-envelope-open-text text-gold"></i> Email Notifications (SMTP)</h3>
                        <p>Configure automated enquiry and site visit email alerts.</p>
                    </div>
                    <form method="POST" action="/admin/settings" class="settings-form">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" name="smtp_configured" value="1" <%= settings.smtp_configured === '1' ? 'checked' : '' %>>
                                Enable Automated SMTP Email Alerts
                            </label>
                        </div>

                        <div class="form-row cols-2">
                            <div class="form-group">
                                <label for="smtp_host">SMTP Host</label>
                                <input type="text" id="smtp_host" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com">
                            </div>
                            <div class="form-group">
                                <label for="smtp_port">SMTP Port</label>
                                <input type="text" id="smtp_port" name="smtp_port" value="<%= settings.smtp_port || '587' %>" placeholder="587">
                            </div>
                        </div>

                        <div class="form-row cols-2">
                            <div class="form-group">
                                <label for="smtp_user">SMTP User / Email</label>
                                <input type="text" id="smtp_user" name="smtp_user" value="<%= settings.smtp_user || '' %>" placeholder="alerts@svrealestate.com">
                            </div>
                            <div class="form-group">
                                <label for="smtp_pass">SMTP Password</label>
                                <input type="password" id="smtp_pass" name="smtp_pass" value="<%= settings.smtp_pass || '' %>" placeholder="••••••••">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-secondary"><i class="fas fa-save"></i> Update Email Settings</button>
                        </div>
                    </form>
                </div>

                <!-- Change Password -->
                <div class="settings-card">
                    <div class="card-header">
                        <h3><i class="fas fa-lock text-gold"></i> Security & Password</h3>
                        <p>Update your admin account login password.</p>
                    </div>
                    <form method="POST" action="/admin/settings/password" class="settings-form">
                        <div class="form-group">
                            <label for="current_password">Current Password</label>
                            <input type="password" id="current_password" name="current_password" required placeholder="••••••••">
                        </div>

                        <div class="form-row cols-2">
                            <div class="form-group">
                                <label for="new_password">New Password (min 8 chars)</label>
                                <input type="password" id="new_password" name="new_password" minlength="8" required placeholder="••••••••">
                            </div>
                            <div class="form-group">
                                <label for="confirm_password">Confirm New Password</label>
                                <input type="password" id="confirm_password" name="confirm_password" minlength="8" required placeholder="••••••••">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Change Password</button>
                        </div>
                    </form>
                </div>

                <!-- System Data & Backup -->
                <div class="settings-card">
                    <div class="card-header">
                        <h3><i class="fas fa-database text-gold"></i> Data Management</h3>
                        <p>Export CRM data and view database health.</p>
                    </div>
                    <div class="backup-actions">
                        <div class="backup-item">
                            <div>
                                <strong>Customer Enquiries & Leads</strong>
                                <p class="text-muted">Export complete lead history in CSV format for CRM analysis or offline backups.</p>
                            </div>
                            <a href="/api/leads/export/csv" class="btn btn-secondary"><i class="fas fa-file-csv"></i> Download CSV</a>
                        </div>
                        <div class="backup-item">
                            <div>
                                <strong>Cloud Database Persistence</strong>
                                <p class="text-muted"><%= (typeof postgresConfigured !== 'undefined' && postgresConfigured) ? 'PostgreSQL / Supabase Cloud Active. All leads, appointments, and sessions are permanently saved across Vercel serverless requests.' : 'Local Database active. For live Vercel deployments, add your Supabase / PostgreSQL DATABASE_URL in Vercel Environment Variables to persist leads and sessions permanently.' %></p>
                            </div>
                            <% if (typeof postgresConfigured !== 'undefined' && postgresConfigured) { %>
                            <span class="status-badge status-published"><i class="fas fa-check-circle"></i> Cloud Connected</span>
                            <% } else { %>
                            <span class="status-badge status-draft"><i class="fas fa-info-circle"></i> Local Fallback</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/admin.js"></script>
</body>
</html>
