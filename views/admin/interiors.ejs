<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <%- include('../partials/admin-sidebar') %>
    
    <main class="admin-main">
        <header class="admin-header">
            <div class="header-left">
                <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <h2><i class="fas fa-couch text-gold"></i> Home Interiors Portfolio Management</h2>
            </div>
            <div class="header-right">
                <a href="/admin/interiors/new" class="btn btn-primary" style="background:var(--gold); color:#0c0f17; font-weight:700;">
                    <i class="fas fa-plus"></i> Add New Interior Project
                </a>
            </div>
        </header>

        <div class="admin-content">
            <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
            <% } %>

            <div class="card">
                <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
                    <h3>All Interior Projects (<%= projects ? projects.length : 0 %>)</h3>
                    <a href="/interiors/projects" target="_blank" class="btn btn-sm btn-secondary">
                        <i class="fas fa-external-link-alt"></i> View Public Portfolio
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Cover</th>
                                <th>Project Title</th>
                                <th>Locality</th>
                                <th>Config</th>
                                <th>Style</th>
                                <th>Budget Range</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
                                <% projects.forEach(p => { %>
                                <tr>
                                    <td>
                                        <% if (p.cover_image) { %>
                                        <img src="<%= p.cover_image %>" alt="<%= p.title %>" style="width: 50px; height: 38px; object-fit: cover; border-radius: 4px;" onerror="this.onerror=null; this.src='/images/brand-banner.png';">
                                        <% } else { %>
                                        <div style="width: 50px; height: 38px; background: #262c3b; display:flex; align-items:center; justify-content:center; border-radius:4px;"><i class="fas fa-couch text-gold"></i></div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= p.title %></strong>
                                        <div style="font-size: 0.8rem; color: var(--text-muted);"><%= p.project_code || 'SV-INT' %></div>
                                    </td>
                                    <td><%= p.locality %></td>
                                    <td><span class="status-badge status-published"><%= p.bhk_config || p.property_type %></span></td>
                                    <td><%= p.design_style || 'Contemporary' %></td>
                                    <td><%= p.budget_range || '-' %></td>
                                    <td>
                                        <span class="status-badge <%= p.is_published ? 'status-published' : 'status-draft' %>">
                                            <%= p.is_published ? 'Published' : 'Draft' %>
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 8px;">
                                            <a href="/admin/interiors/<%= p.id %>/edit" class="btn btn-sm btn-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="POST" action="/admin/interiors/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this interior project?');">
                                                <button type="submit" class="btn btn-sm btn-danger" style="background:none; border:none; color:var(--danger); cursor:pointer;" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center" style="padding: 40px;">No interior projects created yet. Click "Add New Interior Project" above.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/admin.js"></script>
</body>
</html>

