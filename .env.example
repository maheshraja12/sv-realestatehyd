# ==============================================================
# SV Real Estates Hyderabad — Environment Variables Template
# ==============================================================

# ── Cloud PostgreSQL / Supabase / Vercel Postgres Configuration ──
# (Recommended for Vercel: persists leads, appointments, and sessions across serverless Lambdas)
# Format: postgresql://user:password@host:port/database?sslmode=require
# Examples:
#   Supabase: postgresql://postgres.[project-id]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#   Neon:     postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   Vercel:   Automatic when using Vercel Postgres (POSTGRES_URL)
DATABASE_URL=
POSTGRES_URL=

# ── Supabase & Edge Function Configuration (Production Vercel) ──
SV_REAL_ESTATE_SUPABASE_URL=https://your-project.supabase.co
SV_REAL_ESTATE_EDGE_TOKEN_V2=your-edge-function-secret-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key (server-only)

# ── MySQL Database Configuration (Cloud or Local) ────────────
# Option A: Full Connection URL (Recommended for TiDB Cloud, Aiven, Railway, PlanetScale)
# Example: mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/sv_realestate?ssl={"rejectUnauthorized":true}
MYSQL_URL=

# Option B: Individual Connection Parameters (e.g., Local XAMPP or MySQL Server)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sv_realestate
MYSQL_SSL=false

# ── Local SQLite Database (Seamless local offline fallback) ──
DATABASE_PATH=./data/svrealestate.db

# ── Server Configuration ─────────────────────────────────────
PORT=5000
ALT_PORT=5001
NODE_ENV=development

# ── Session Security ─────────────────────────────────────────
SESSION_SECRET=sv-realestate-dev-session-secret-change-in-production-2024

# ── Admin Portal Credentials ─────────────────────────────────
# 1. Super Admin (Full access to all modules, permission manager, settings)
SUPERADMIN_EMAIL=superadmin@svrealestate.com
SUPERADMIN_PASSWORD=SuperAdmin@SV2024
SUPERADMIN_NAME=SV Super Admin

# 2. Normal Admin (By default accesses Leads & Enquiries; modules controlled by Super Admin)
ADMIN_EMAIL=admin@svrealestate.com
ADMIN_PASSWORD=Admin@SV2024
ADMIN_NAME=SV Admin

